# ============================================================
# WestPay — Variables d'environnement (à configurer dans Plesk)
# Copie ce fichier en .env et remplis les valeurs
# ============================================================

# ----- APP -----
NODE_ENV=production
PORT=5000
APP_URL=http://Westpay.cfd
SESSION_SECRET=change_me_avec_une_chaine_aleatoire_longue

# ----- BASE DE DONNÉES PostgreSQL -----
DATABASE_URL=postgresql://user:password@localhost:5432/westpay

# ----- SEAPAY — Pakistan -----
SEAPAY_PAKISTAN_MERCHANT_ID=
SEAPAY_PAKISTAN_API_KEY=
SEAPAY_PAKISTAN_API_SECRET=

# ----- SEAPAY — Philippines -----
SEAPAY_PHILIPPINES_MERCHANT_ID=
SEAPAY_PHILIPPINES_API_KEY=
SEAPAY_PHILIPPINES_API_SECRET=

# ----- SEAPAY — Inde -----
SEAPAY_INDIA_MERCHANT_ID=
SEAPAY_INDIA_API_KEY=
SEAPAY_INDIA_API_SECRET=

# ----- OMNIPAY -----
OMNIPAY_API_KEY=
OMNIPAY_SECRET_KEY=

# ----- MBIYO -----
MBIYO_API_KEY=
MBIYO_SECRET=

# ----- SENDAVAPAY -----
SENDAVAPAY_API_KEY=

# ----- OXAPAY (crypto) -----
OXAPAY_MERCHANT_KEY=

# ----- TELEGRAM (optionnel) -----
TELEGRAM_BOT_TOKEN=
TELEGRAM_OTP_BOT_TOKEN=
TELEGRAM_ADMIN_GROUP_ID=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
